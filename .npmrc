# Metro (React Native's bundler) doesn't follow pnpm's default strict,
# symlinked node_modules layout well in a monorepo — this is Expo's own
# documented recommendation for pnpm workspaces (docs.expo.dev/guides/
# monorepos). Hoisted linking makes node_modules look like npm/yarn
# classic's flat layout, which Metro resolves natively.
node-linker=hoisted
