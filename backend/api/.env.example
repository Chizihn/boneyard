DATABASE_URL="postgresql://boneyard:boneyard@localhost:5432/boneyard"
JWT_SECRET="change-me-in-production"
PORT=4000
# Comma-separated list of allowed origins, or "*" for any (dev only).
# Leave unset to fall back to a localhost-only allowlist — see main.ts.
# CORS_ORIGIN="http://localhost:8081,https://admin.example.com"


# Separate secret (from your Bachs dashboard) used to verify incoming
# webhook signatures — see docs.bachs.io/guides/refunds for the HMAC scheme.
# --- Bachs Connect (Global Marketplace Payments) ---
BACHS_API_URL="https://sandbox-api.bachs.io"
BACHS_SECRET_KEY=""
BACHS_WEBHOOK_SECRET=""

# Redirect targets after the requester finishes/cancels Bachs checkout.
# Defaulted to a placeholder in env.validation.ts — override once
# apps/hallowear and apps/haint exist and can deep-link into themselves.
# BACHS_CHECKOUT_SUCCESS_URL="https://your-app.example/payment/success"
# BACHS_CHECKOUT_CANCEL_URL="https://your-app.example/payment/cancel"
